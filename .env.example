# Google Analytics 4 Measurement ID. Without this, GA does not load (it is also
# consent-gated). Create .env.local and set your real ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Absolute site URL — used as metadataBase to resolve og:image to an absolute
# URL for social cards. Set to your deployed domain in production.
NEXT_PUBLIC_SITE_URL=https://hackdraft.com
